<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_canvas">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/page_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        app:navigationIcon="@drawable/ui_back"
        app:navigationContentDescription="@string/back"
        app:contentInsetEnd="20dp">
        <com.example.fourlink.HeadingTextView
            style="@style/Ui.Subheading"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/developers" />
    </com.google.android.material.appbar.MaterialToolbar>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.example.fourlink.ContentColumn
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/page_gutter"
                android:layout_gravity="top|center_horizontal">
                <TextView
                    style="@style/Ui.Body"
                    android:text="@string/developer_intro"
                    android:layout_marginBottom="20dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <LinearLayout style="@style/Ui.Panel">
                            <ImageView
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:src="@drawable/dev1"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter"
                                android:id="@+id/developer1_image"
                                android:layout_marginBottom="16dp" />
                            <com.example.fourlink.HeadingTextView
                                style="@style/Ui.Heading"
                                android:text="@string/dev1_name" />
                            <TextView
                                style="@style/Ui.Body"
                                android:text="@string/dev1_role"
                                android:textColor="@color/ui_accent"
                                android:layout_marginTop="4dp" />
                            <TextView
                                style="@style/Ui.Body"
                                android:text="@string/dev1_bio"
                                android:layout_marginTop="16dp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <LinearLayout style="@style/Ui.Panel">
                            <ImageView
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:src="@drawable/dev2"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter"
                                android:id="@+id/developer2_image"
                                android:layout_marginBottom="16dp" />
                            <com.example.fourlink.HeadingTextView
                                style="@style/Ui.Heading"
                                android:text="@string/dev2_name" />
                            <TextView
                                style="@style/Ui.Body"
                                android:text="@string/dev2_role"
                                android:textColor="@color/ui_accent"
                                android:layout_marginTop="4dp" />
                            <TextView
                                style="@style/Ui.Body"
                                android:text="@string/dev2_bio"
                                android:layout_marginTop="16dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    style="@style/Ui.Panel"
                    android:background="@drawable/ui_hero">
                    <TextView
                        style="@style/Ui.Eyebrow"
                        android:text="@string/project_label"
                        android:textColor="@color/ui_yellow" />
                    <com.example.fourlink.HeadingTextView
                        style="@style/Ui.Heading"
                        android:text="@string/project_title"
                        android:textColor="@color/ui_on_hero"
                        android:layout_marginTop="12dp" />
                    <TextView
                        style="@style/Ui.Body"
                        android:text="@string/project_body"
                        android:textColor="@color/ui_hero_muted"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.example.fourlink.ContentColumn>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
