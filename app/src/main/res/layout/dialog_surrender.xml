<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_card"
    android:fillViewport="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ui_flag"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:layout_marginBottom="16dp"
            android:background="@drawable/ui_badge"
            android:padding="8dp" />
        <com.example.fourlink.HeadingTextView
            android:id="@+id/tvSurrenderMessage"
            style="@style/Ui.Heading"
            android:text="@string/surrender_title" />
        <TextView
            android:id="@+id/surrender_consequence"
            style="@style/Ui.Body"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNo"
            style="@style/Ui.Button"
            android:text="@string/keep_playing" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnYes"
            style="@style/Ui.Button.Danger"
            android:text="@string/surrender"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
