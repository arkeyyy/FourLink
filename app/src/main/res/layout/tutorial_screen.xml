<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_tutorial_canvas">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/page_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        app:navigationIcon="@drawable/ui_back"
        app:navigationContentDescription="@string/back"
        app:contentInsetEnd="20dp">
        <com.example.fourlink.HeadingTextView
            style="@style/Ui.Subheading"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/tutorial" />
    </com.google.android.material.appbar.MaterialToolbar>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.example.fourlink.ContentColumn
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/page_gutter"
                android:layout_gravity="top|center_horizontal">
                <TextView
                    style="@style/Ui.Eyebrow"
                    android:text="@string/tutorial_tag" />
                <com.example.fourlink.HeadingTextView
                    style="@style/Ui.Title"
                    android:text="@string/tutorial_heading"
                    android:layout_marginTop="12dp" />
                <TextView
                    style="@style/Ui.Body"
                    android:text="@string/tutorial_intro"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp" />
                <LinearLayout style="@style/Ui.Card">
                    <com.example.fourlink.HeadingTextView
                        style="@style/Ui.Subheading"
                        android:text="@string/step_one" />
                    <TextView
                        style="@style/Ui.Body"
                        android:text="@string/step_one_body"
                        android:layout_marginTop="8dp" />
                    <com.example.fourlink.HeadingTextView
                        style="@style/Ui.Subheading"
                        android:text="@string/step_two"
                        android:layout_marginTop="20dp" />
                    <TextView
                        style="@style/Ui.Body"
                        android:text="@string/step_two_body"
                        android:layout_marginTop="8dp" />
                    <com.example.fourlink.HeadingTextView
                        style="@style/Ui.Subheading"
                        android:text="@string/step_three"
                        android:layout_marginTop="20dp" />
                    <TextView
                        style="@style/Ui.Body"
                        android:text="@string/step_three_body"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
                <com.example.fourlink.HeadingTextView
                    style="@style/Ui.Heading"
                    android:text="@string/winning_patterns"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp" />
                <com.example.fourlink.PatternRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <LinearLayout
                        style="@style/Ui.Card"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="156dp"
                            android:src="@drawable/ui_win_horizontal"
                            android:contentDescription="@string/example_horizontal"
                            android:scaleType="fitCenter"
                            android:layerType="software" />
                        <TextView
                            style="@style/Ui.Subheading"
                            android:text="@string/horizontal"
                            android:gravity="center"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Ui.Card"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="156dp"
                            android:src="@drawable/ui_win_vertical"
                            android:contentDescription="@string/example_vertical"
                            android:scaleType="fitCenter"
                            android:layerType="software" />
                        <TextView
                            style="@style/Ui.Subheading"
                            android:text="@string/vertical"
                            android:gravity="center"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.example.fourlink.PatternRow>
                <com.example.fourlink.PatternRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">
                    <LinearLayout
                        style="@style/Ui.Card"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="156dp"
                            android:src="@drawable/ui_win_diagonal_up"
                            android:contentDescription="@string/example_diagonal_up"
                            android:scaleType="fitCenter"
                            android:layerType="software" />
                        <TextView
                            style="@style/Ui.Subheading"
                            android:text="@string/diagonal_up"
                            android:gravity="center"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                    <LinearLayout
                        style="@style/Ui.Card"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:padding="16dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="156dp"
                            android:src="@drawable/ui_win_diagonal_down"
                            android:contentDescription="@string/example_diagonal_down"
                            android:scaleType="fitCenter"
                            android:layerType="software" />
                        <TextView
                            style="@style/Ui.Subheading"
                            android:text="@string/diagonal_down"
                            android:gravity="center"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.example.fourlink.PatternRow>
                <LinearLayout
                    style="@style/Ui.Panel"
                    android:background="@drawable/ui_badge">
                    <com.example.fourlink.HeadingTextView
                        style="@style/Ui.Subheading"
                        android:text="@string/draw_rule" />
                    <TextView
                        style="@style/Ui.Body"
                        android:text="@string/draw_rule_body"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.example.fourlink.ContentColumn>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
