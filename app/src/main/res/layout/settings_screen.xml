<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ui_canvas">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/page_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        app:navigationIcon="@drawable/ui_back"
        app:navigationContentDescription="@string/back"
        app:contentInsetEnd="20dp">
        <com.example.fourlink.HeadingTextView
            style="@style/Ui.Subheading"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/settings" />
    </com.google.android.material.appbar.MaterialToolbar>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.example.fourlink.ContentColumn
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/page_gutter"
                android:layout_gravity="top|center_horizontal">
                <LinearLayout
                    style="@style/Ui.Card"
                    android:background="@drawable/ui_settings_panel">
                    <com.example.fourlink.HeadingTextView
                        style="@style/Ui.Subheading"
                        android:text="@string/appearance"
                        android:textColor="@color/ui_on_settings" />
                    <TextView
                        style="@style/Ui.Body"
                        android:text="@string/appearance_body"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ui_on_settings" />
                    <RadioGroup
                        android:id="@+id/theme_options"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:fontFamily="@font/amaranthregular"
                            android:id="@+id/theme_system"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:padding="12dp"
                            android:text="@string/theme_system"
                            android:textSize="16sp"
                            android:textColor="@color/ui_option_text"
                            android:buttonTint="@color/ui_option_text"
                            android:background="@drawable/ui_option_background"
                            android:layout_marginBottom="8dp"
                            android:foreground="?attr/selectableItemBackground" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:fontFamily="@font/amaranthregular"
                            android:id="@+id/theme_light"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:padding="12dp"
                            android:text="@string/theme_light"
                            android:textSize="16sp"
                            android:textColor="@color/ui_option_text"
                            android:buttonTint="@color/ui_option_text"
                            android:background="@drawable/ui_option_background"
                            android:layout_marginBottom="8dp"
                            android:foreground="?attr/selectableItemBackground" />
                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:fontFamily="@font/amaranthregular"
                            android:id="@+id/theme_dark"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:padding="12dp"
                            android:text="@string/theme_dark"
                            android:textSize="16sp"
                            android:textColor="@color/ui_option_text"
                            android:buttonTint="@color/ui_option_text"
                            android:background="@drawable/ui_option_background"
                            android:layout_marginBottom="8dp"
                            android:foreground="?attr/selectableItemBackground" />
                    </RadioGroup>
                </LinearLayout>
                <TextView
                    style="@style/Ui.Caption"
                    android:text="@string/theme_hint"
                    android:layout_marginBottom="28dp" />
                <LinearLayout
                    style="@style/Ui.Card"
                    android:background="@drawable/ui_settings_panel">
                    <TextView
                        style="@style/Ui.Eyebrow"
                        android:text="@string/about"
                        android:layout_marginBottom="12dp"
                        android:textColor="@color/ui_on_settings" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dev_bar"
                        style="@style/Ui.Button.DialogSecondary"
                        android:text="@string/developers"
                        app:icon="@drawable/ui_arrow"
                        app:iconGravity="end"
                        app:backgroundTint="@color/ui_settings_row"
                        android:textColor="@color/ui_on_settings_row"
                        app:iconTint="@color/ui_on_settings_row" />
                    <TextView
                        android:id="@+id/app_version"
                        style="@style/Ui.Caption"
                        android:layout_marginTop="24dp"
                        android:textColor="@color/ui_on_settings" />
                </LinearLayout>
            </com.example.fourlink.ContentColumn>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
